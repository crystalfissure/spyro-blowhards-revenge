# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a

# Executables
*.exe
*.out
*.app
*.ipa

# these project files can be generated by the engine
*.xcodeproj
*.sln
*.suo
*.opensdf
*.sdf
*.sln
*.abc

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*

# Builds
Build/*

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Mac Artifacts
.DS_Store

# Vim Artifacts
*.swp
*.swo
.ctrlp_cache/

# Visual Studio
.vs/*
*.VC.opendb
*.VC.db

# Local Plugins
**/Plugins/**/Intermediate/*
**/Plugins/**/Binaries/*
**/Plugins/**/Saved/*

# Redistributable Win64 editor modules (UE 4.27.2). Keep this allowlist exact:
# PDBs, hot-reload DLLs, build receipts and Intermediate remain local.
!/Plugins/MMAEditorTools/Binaries/Win64/
/Plugins/MMAEditorTools/Binaries/Win64/*
!/Plugins/MMAEditorTools/Binaries/Win64/UE4Editor-MMAEditorTools.dll
!/Plugins/MMAEditorTools/Binaries/Win64/UE4Editor-MMAGameplay.dll
!/Plugins/MMAEditorTools/Binaries/Win64/UE4Editor.modules
!/Plugins/PS1IsoGate/Binaries/Win64/
/Plugins/PS1IsoGate/Binaries/Win64/*
!/Plugins/PS1IsoGate/Binaries/Win64/UE4Editor-PS1IsoGate.dll
!/Plugins/PS1IsoGate/Binaries/Win64/UE4Editor.modules
!/Plugins/SM64Runtime/Binaries/Win64/
/Plugins/SM64Runtime/Binaries/Win64/*
!/Plugins/SM64Runtime/Binaries/Win64/UE4Editor-SM64Runtime.dll
!/Plugins/SM64Runtime/Binaries/Win64/UE4Editor-SM64RuntimeEditor.dll
!/Plugins/SM64Runtime/Binaries/Win64/UE4Editor.modules
!/Plugins/SpyroGameplay/Binaries/Win64/
/Plugins/SpyroGameplay/Binaries/Win64/*
!/Plugins/SpyroGameplay/Binaries/Win64/UE4Editor-SpyroGameplay.dll
!/Plugins/SpyroGameplay/Binaries/Win64/UE4Editor-SpyroEditor.dll
!/Plugins/SpyroGameplay/Binaries/Win64/UE4Editor.modules

# Temp Files
Config/DefaultEditorPerProjectUserSettings.ini

# blend1 Files (used by blender for backups)
*.blend1

# Level meshes exported from blender
Blends/*.fbx

